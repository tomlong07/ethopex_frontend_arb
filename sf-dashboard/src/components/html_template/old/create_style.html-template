async function init() {
  if (!MODE){
    console.error("Missing mode");
    divDone.innerHTML += "<br>Missing mode";
    return;
  }

  console.log("init"+ " v" + VERSION + " " + (MODE_CREATE? "create" : "update"));

  let info = getGoogleInfo();

  info.adsenseId = getAdsenseId();


  if (!info.adsenseId) { console.error("Missing adsenseId");divDone.innerHTML += "<br>Missing adsenseId";};

  console.log(info);

  if (ORIGINAL_STYLE){
    let res = await getOldDataById(ORIGINAL_STYLE, info);
    res = handleResponse(res);

    if (res["1"]["1"] == ORIGINAL_STYLE){
      console.info("Get data "+ORIGINAL_STYLE+" success!");
    }

    console.log(res);
    return;
  }

  if (MODE_UPDATE){
    if (!UPDATE_IDS || UPDATE_IDS.length == 0) {
      console.error("Missing update ids");
      divDone.innerHTML += "<br>Missing update ids";
      return;
    }

    for (let index = 0; index < UPDATE_IDS.length; index++) {
      await updateOneStyleById(info, UPDATE_IDS[index]);
    }

    divDone.innerHTML += "<br>Updated success!";

    return;
  }

  if (MODE_CREATE){
    if (!NUMBER_STYLE || !START_STYLE_ID){
      divDone.innerHTML += "<br>Missing NUMBER_STYLE or START_STYLE_ID!";
      return;
    }
    let jobs = [];

    for (let index = START_STYLE_ID; index <= NUMBER_STYLE; index++) {
      let name = NAME_STYLE + index + " - " + dateNow();

      if (STYLE_TYPE != "") {
        name += " " + STYLE_TYPE;
      }

      jobs.push({ name: name });
    }

    // jobs = [
    //   { name: "[NEW_v3] Layout 14" },
    // ];

    console.log(jobs);

    let dataResponse = [];

    for (let index = 0; index < jobs.length; index++) {

      console.log(jobs[index]);

      notifyDiv.innerHTML += "<br>Doing job: " + jobs[index].name;

      const jobDone = await doingOneJob(info, jobs[index]);
      const update = await tryUpdateToDB(info, jobDone);
      if (!update || !update.status) {
        notifyDiv.innerHTML += "<br>Error update to DB";

        console.error("Error update to DB");
        return;
      }
      dataResponse.push(jobDone);

      await sleep(TIME_SLEEP);
    }

    divDone.innerHTML += "<br>Created success!";

    console.log("dataResponse: ", dataResponse);
    return;
  } 
}

async function tryUpdateToDB(e, t) { let a = MAX_RETRIES_UPDATE_DB; for (; a > 0;)try { let r = await updateToDB(e.adsenseId, t); return console.info("Update successful", t), r } catch (d) { console.error("Update failed. Retrying..."), --a > 0 && await sleep(TIME_SLEEP_UPDATE_DB) } console.error("Max retries exceeded. Update failed.", t) }

async function updateToDB(pubId, opts = {}) {

  let obj = {
    "name": opts.name,
    "pub_id": pubId,
    "type": STYLE_TYPE,
    "related_search_id": Number(opts.relatedSearchId),
    "search_page_id": Number(opts.searchPageId),
    "shopping_style_id": Number(opts.shoppingStyleId),
    "status": "ok",
    "style_id": Number(opts.styleId),
  }

  if (STYLE_TYPE != "") obj.type = STYLE_TYPE;

  let headers = {"content-type": "application/json"};
  headers[HNAME] = HVALUE;

  var settings = {
    "url": HLINK,
    "method": "POST",
    "timeout": 0,
    "headers": headers,
    "data": JSON.stringify(obj),
  };

  return await $.ajax(settings)
}

async function updateOneStyleById(info, id) {
  if (!id) {
    console.error("updateOneStyleById: Missing id");
    return;
  }

  if (!list) {
    list = await fetchListStyle(info);
    list = handleResponse(list);

    console.info("list style in this adsense:", list);
  }

  for (let index = 0; index < list["1"].length; index++) {
    const element = list["1"][index];

    if (element["1"] == id) {

      let newStyle = {
        xsrfToken: info.xsrfToken,
        adsenseId: info.adsenseId,
      };
      newStyle.styleId = element["1"];

      let oldName = element["2"];
      
      if (NAME_STYLE){
        newStyle.name = NAME_STYLE + (STYLE_TYPE ? ("_"+STYLE_TYPE) : "") + " - " + Date.now();
      }else{
        newStyle.name = oldName;
      }

      for (let i = 0; i < element["8"]["10"].length; i++) {
        const e = element["8"]["10"][i];

        switch (e["2"]["2"]) {
          case "Shopping style":
            newStyle.shoppingStyleId = e["2"]["1"];
            break;
          case "Related searches":
            newStyle.relatedSearchId = e["2"]["1"];
            break;
          case "Search Page":
            newStyle.searchPageId = e["2"]["1"];
            break;
        }
      }

      await doingUpdateOneById(newStyle, "search");
      await doingUpdateOneById(newStyle, "relatedSearch");
      await doingUpdateOneById(newStyle, "searchPage");

      await doingUpdateOneById(newStyle, "condSearch");
    }
  }
}

async function doingOneJob(info, data) {
  if (!data.name) {
    console.error("Missing name");
    return;
  }

  console.log("Doing job: ", data.name);

  let newInfo = JSON.parse(JSON.stringify(info));
  newInfo.name = data.name;

  if (data.styleId) {
    newInfo.styleId = data.styleId;
    newInfo.shoppingStyleId = data.shoppingStyleId;
  } else {
    let responseCreateStep1 = await doingCreateNewStyle(newInfo);

    if (responseCreateStep1.name != newInfo.name) {
      console.error("Error creating style, name not match: " + newInfo.name + " - " + responseCreateStep1.name);
      return
    }

    newInfo.styleId = responseCreateStep1.styleId;
    newInfo.shoppingStyleId = responseCreateStep1.shoppingStyleId;

    await sleep(TIME_SLEEP);
  }

  console.log("styleID: ", newInfo.styleId);
  console.log("shoppingStyleId: ", newInfo.shoppingStyleId);

  if (data.relatedSearchId) {
    newInfo.relatedSearchId = data.relatedSearchId;
  } else {
    newInfo.relatedSearchId = await doingCreateRelatedSearch(newInfo);
    await sleep(TIME_SLEEP);
  }

  console.log("relatedSearchId: ", newInfo.relatedSearchId);

  if (data.searchPageId) {
    newInfo.searchPageId = data.searchPageId;
  } else {
    newInfo.searchPageId = await doingCreateSearchPage(newInfo);

    await sleep(TIME_SLEEP);
  }

  console.log("searchPageId: ", newInfo.searchPageId);

  await sleep(TIME_SLEEP);

  await doingUpdateOneById(newInfo, "search");
  await doingUpdateOneById(newInfo, "relatedSearch");
  await doingUpdateOneById(newInfo, "searchPage");

  return {
    name: newInfo.name, styleId: newInfo.styleId,
    shoppingStyleId: newInfo.shoppingStyleId,
    relatedSearchId: newInfo.relatedSearchId,
    searchPageId: newInfo.searchPageId,
  };
}

async function doingCreateNewStyle(info) {
  let responseCreateStep1 = await createNewStyle(info);

  responseCreateStep1 = handleResponse(responseCreateStep1);

  return getStyleId(responseCreateStep1);
}

async function doingCreateRelatedSearch(info) {
  let responseCreateStep2 = await createNewRelatedSearch(info);

  responseCreateStep2 = handleResponse(responseCreateStep2);

  return getRelatedSearchId(responseCreateStep2);
}

function getRelatedSearchId(response) {
  return response["1"]["1"];
}

async function doingCreateSearchPage(info) {
  let responseCreateStep3 = await createNewSearchPageInRelatedSearch(info);
  responseCreateStep3 = handleResponse(responseCreateStep3);
  return getSearchPageId(responseCreateStep3);
}

function getSearchPageId(response) {
  return response["1"]["1"];
}

function handleResponse(response) {
  try {
    response = response.replace(")]}'\n", "").replace(")\n]\n}'\n\n", "");

    response = JSON.parse(response);
    return response;

  } catch (error) {
    console.error(error);
  }
}

function getStyleId(response) {
  if (!response["1"]) {

    if (response["2"] && JSON.stringify(response["2"]) == '{"1":1}') {
      console.error("Can not create style, duplicate name");
      return
    }

    console.error("Error getting style id");
    return;
  }

  return { name: response["1"]["4"], styleId: response["1"]["1"], shoppingStyleId: response["3"]["1"] };
}

function getGoogleInfo() {
  try {
    let app_state = window.__asfe_app_state;

    let appInfo = JSON.parse(app_state);

    return { err: null, xsrfToken: appInfo["6"] };

  } catch (error) {
    return { err: "Error parsing app_state" };
  }
}


async function fetchListStyle(opts = {}) {
  if (!opts.adsenseId || !opts.xsrfToken) {
    console.error("Missing info");
    return
  }

  var settings = {
    "url": "https://www.google.com/adsense/service/myads/GetSearchAdStyles?pid=pub-" + opts.adsenseId + "&authuser=0&tpid=pub-" + opts.adsenseId + "&ov=3&hl=en_US&rpcTrackingId=%2Fadsense%2Fservice%2Fmyads%2FGetSearchAdStyles%3Fpid%3Dpub-" + opts.adsenseId + "%26authuser%3D0%26tpid%3Dpub-" + opts.adsenseId + "%26ov%3D3%26hl%3Den_US%3A1",
    "method": "POST",
    "timeout": 0,
    "headers": {
      "activitylabels": "",
      "activityname": "Initial Load",
      "activitytrackingid": "myads",
      "content-type": "application/json;charset=UTF-8",
      "x-framework-xsrf-token": opts.xsrfToken
    },
    "data": "{}",
  };

  let res;
  try { await $.ajax(settings) } catch (error) { res = error.responseText; }
  return res;
}

