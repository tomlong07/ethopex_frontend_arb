const MODE = '{{{import_mode}}}';
const MODE_CREATE = MODE === "create";
const MODE_UPDATE = MODE === "update";

console.log("MODE_CREATE: " + MODE_CREATE);
console.log("MODE_UPDATE: " + MODE_UPDATE);

