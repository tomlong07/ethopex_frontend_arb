		//1827576431 Set target CPMs

		let info = getInfo(opts);

		if (!info.ok) {
			console.error("Please check info", info);
			return { ok: false, data: "Please check info", info: info };
		}

		let payload = {
    "method": "createPricingRule",
    "params": {
        "2": {
            "1119": "552887103580793414"
        },
        "1532": {
            "1025": 1925346054,
            "2103": {
                "163": {},
								"845": opts.adUnits,
