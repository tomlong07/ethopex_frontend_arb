<script>
	//Import from vuejs
	const dataRules = {{{import_data}}};
	const pricingIds = {{{import_update_ids}}};
	const adManagerId = "{{{import_admanager_account}}}";
	const VERSION = '{{{import_version}}}';

	const name = "{{{import_name}}}";
	const pricingType = "{{{import_pricing}}}";
	const DEBUG = {{{import_debug}}};

	const HLINK = '{{{import_hlink}}}';
	const HNAME = '{{{import_hname}}}';
	const HVALUE = '{{{import_hvalue}}}';

	console.info("DEBUG: " + DEBUG);

	const MODE = '{{{import_mode}}}';
	const MODE_CREATE = MODE === "create";
	const MODE_UPDATE = MODE === "update";

	const MAX_RETRY = 3;
	const MAX_RETRIES_UPDATE_DB = 5;
	const TIME_TO_WAIT = 7;// thời gian request google giữa mỗi lần
	const TIME_SLEEP_UPDATE_DB = 2e3;

	console.info("MODE_CREATE: " + MODE_CREATE);
	console.info("MODE_UPDATE: " + MODE_UPDATE);

	let notifyDiv = null, divDone = null, divCopy = null;
	let statusJob = { created: 0, updated: 0, error: 0 };
	let errIds = [];
	let objectGGIDsWithUniqueId = {};
	const networkId = window.location.pathname.replace("/", "");

	function loadJQuery() { var e = document.createElement("script"); e.src = "https://code.jquery.com/jquery-3.6.0.min.js", e.onload = function () { console.info("jQuery loaded successfully!"), $(document).ready(function () { setTimeout(() => { init() }, 5e3) }) }, document.head.appendChild(e) }

	function clearFixed() { let e = document.querySelectorAll(".fixed-div"); e.forEach(e => { e.remove() }) }
	function addFixedDivDoneToBody() { (divDone = document.createElement("div")).classList.add("fixed-div", "fixed-div-done"), divDone.textContent = "Status:" + " v" + VERSION, document.body.appendChild(divDone); var d = document.createElement("style"); d.textContent = ".fixed-div-done{position:fixed;top:200px;right:500px;width:200px;height:100px;background-color:#f0f0f0;border:1px solid #ccc;padding:10px;border-radius:5px;box-shadow:0 0 10px rgba(0,0,0,.2);z-index:9999;font-size:20px;color:green}", document.head.appendChild(d) } function addFixedDivToBody() { (notifyDiv = document.createElement("div")).classList.add("fixed-div", "fixed-div-notify"), notifyDiv.textContent = "Notify:", document.body.appendChild(notifyDiv); var d = document.createElement("style"); d.textContent = ".fixed-div-notify{position:fixed;top:200px;right:200px;width:200px;height:500px;overflow:scroll;background-color:#f0f0f0;border:1px solid #ccc;padding:10px;border-radius:5px;box-shadow:0 0 10px rgba(0,0,0,.2);z-index:9999}", document.head.appendChild(d) }
	function addFixedDivCopyToBody() { (divCopy = document.createElement("div")).classList.add("fixed-div", "fixed-div-copy"), divCopy.textContent = "Job", document.body.appendChild(divCopy); var d = document.createElement("style"); d.textContent = ".fixed-div-copy{position:fixed;top: 400px;right: 500px;width:200px;height:100px;cursor:pointer;background-color:#f0f0f0;border:1px solid #ccc;padding:10px;border-radius:5px;box-shadow:0 0 10px rgba(0,0,0,.2);z-index:9999;font-size:20px;color:green;word-wrap: break-word}", document.head.appendChild(d) }
	function notify(e) { console.info(e), notifyDiv.innerHTML += "<br>" + e }
	function status(status = "") { if (!status) { return; }; statusJob[status]++, divCopy.innerHTML = JSON.stringify(statusJob) }
	function done(e) { console.info(e), divDone.innerHTML += "<br>" + e }
	async function sleep(e) { return new Promise(n => setTimeout(n, e)) } function dateNow() { var e, n = new Date, t = n.getDate(), r = n.getMonth() + 1; return n.getFullYear() + "-" + (r < 10 ? "0" : "") + r + "-" + (t < 10 ? "0" : "") + t }
	function clone(input) { return JSON.parse(JSON.stringify(input)) };

	clearFixed(), addFixedDivToBody(), addFixedDivDoneToBody(), addFixedDivCopyToBody(""), loadJQuery();



	async function init() {
		if (adManagerId !== networkId) {
			done("Network ID is not correct " + adManagerId + " vs " + networkId);
			return;
		}

		if (!dataRules || dataRules.length === 0) {
			done("Missing dataRules");

			return;
		}

		if (MODE_CREATE) {
			create();
			return;
		}

		if (!pricingIds || pricingIds.length === 0) {
			done("Missing pricingIds");

			return;
		}

		notify(adManagerId + " starting...")


		let timeRun = dataRules.length;
		if (timeRun > 200) {
			done("Too many rule, please decrease it!");

			return;
		}

		if (timeRun > pricingIds.length) {
			done("Please check dataRules and pricingIds, they are not match!" + "dataRules: " + dataRules.length + " vs pricingIds: " + pricingIds.length);
			return;
		}

		let dataInGoogle = await getListPricingRulesV2({ limit: "300" });

		for (let index = 0; index < dataInGoogle.data.length; index++) {
			const element = dataInGoogle.data[index];
			if (!objectGGIDsWithUniqueId[element["151"]]) {

				try {
					objectGGIDsWithUniqueId[element["151"]] = element["3171"][0]["1555"];

				} catch (error) {
					console.error(element, error);
				}
			}
		}


		for (let index = 0; index < dataRules.length; index++) {
			const element = dataRules[index];
			const pricing_rule_id = pricingIds[index];

			await doing(element, pricing_rule_id);
		}

		if (errIds.length != 0) {
			console.info("Try again error ids: " + JSON.stringify(errIds));
			statusJob.failed = 0;
			const newUpdateIds = clone(errIds);
			errIds = [];
			for (let index = 0; index < newUpdateIds.length; index++) {
				const element = newUpdateIds[index];

				await doing(element.element, element.pricing_rule_id);
			}
		}

		if (errIds.length != 0) {
			console.info("Can not update error ids: " + JSON.stringify(errIds));
			notify("Can not update error ids: " + JSON.stringify(errIds));
		}
		done("Success!");
	}

	async function tryUpdateToDB(r) { if (DEBUG) return; let t = MAX_RETRIES_UPDATE_DB; for (; t > 0;)try { let a = await updateToDB(r); return console.info("Update successful", r), a } catch (d) { console.error("Update failed. Retrying..."), --t > 0 && await sleep(TIME_SLEEP_UPDATE_DB) } console.error("Max retries exceeded. Update failed.", r) }

	async function updateToDB(opts = {}) {

		let obj = {
			"name": opts.name,
			"gam_id": adManagerId,
			"pricing_rule_id": Number(opts.pricing_rule_id),
		}

		let headers = { "content-type": "application/json" };
		headers[HNAME] = HVALUE;

		var settings = {
			"url": HLINK,
			"method": "POST",
			"timeout": 0,
			"headers": headers,
			"data": JSON.stringify(obj),
		};

		return await $.ajax(settings)
	}

	async function create() {
		notify(adManagerId + " create starting...");

		for (let index = 0; index < dataRules.length; index++) {
			const element = dataRules[index];

			await doingCreate(element);
		}
	}

	async function doingCreate(element) {
		await sleep(TIME_TO_WAIT * 1000);

		const maxRetry = MAX_RETRY;
		let retryCount = 0;
		let ggRes;

		while (retryCount < maxRetry) {
			try {
				ggRes = await createPricingRule(
					getInfoPricing(element, {
						name: name + " - " + Date.now(),
					}));
			} catch (error) {
				ggRes = error;
			}

			console.info(ggRes, "ggRes");
			if (ggRes.ok) {
				console.info("success");
				notify("success: ");
				status("created");

				const update = await tryUpdateToDB({ name: ggRes.data.name, pricing_rule_id: isString(ggRes.data.id) ? Number(ggRes.data.id) : ggRes.data.id });
				if (update !== "ok") {
					notify("Error update to DB");
					console.error(update);
				}

				break; // Thoát vòng lặp nếu thành công
			} else {
				retryCount++;
				if (retryCount < maxRetry) {
					await sleep(10000); // Chờ 10 giây trước khi thử lại
				}
			}
		}

		if (!ggRes.ok) {
			status("error");

			notify("error");
			return;
		}
	}

