	async function doing(element, pricing_rule_id) {
		await sleep(TIME_TO_WAIT * 1000);

		const text = 'Doing job: pricing_rule_id: ' + pricing_rule_id;

		console.info(text);

		notify(text);

		const maxRetry = MAX_RETRY;
		let retryCount = 0;
		let ggRes;

		while (retryCount < maxRetry) {
			try {
				ggRes = await updatePricingRuleV2(
					getInfoPricing(element, {
						isUpdate: true, pricing_rule_id: pricing_rule_id,
						objectGGIDsWithUniqueId: objectGGIDsWithUniqueId,
						name: name + " - " + Date.now(),
					}));
			} catch (error) {
				ggRes = error;
			}

			console.info(ggRes, "ggRes");
			if (ggRes.ok) {
				console.info("success");
				notify("<success: " + pricing_rule_id);
				status("updated");
				break; // Thoát vòng lặp nếu thành công
			} else {
				retryCount++;
				if (retryCount < maxRetry) {
					await sleep(10000); // Chờ 10 giây trước khi thử lại
				}
			}
		}

		if (!ggRes.ok) {
			let payload = {
				id: element.id,
				log: JSON.stringify(ggRes),
			}

			status("error");
			errIds.push({ element: element, pricing_rule_id: pricing_rule_id });

			console.error("error", pricing_rule_id);
			notify("error: " + pricing_rule_id);
		}
	}

	function getInfo(opts = {}) {
		let res = {
			pricing: "",
			customValue: null,
			ok: true,
		};

		let temp = 0.0;

		switch (true) {
			case typeof opts.price == "number":
				temp = opts.price
				break;
			case isString(opts.price):
				temp = parseFloat(opts.price)
				break;
			default:
				break;
		}

		if (!temp) {
			res.ok = false;
			console.error("Please check price", opts.price);
		}

		temp = temp.toFixed(2);

		temp = temp * 1000000;
		temp = Math.round(temp);

		res.pricing = temp.toString();

		return res;
	}

	function isString(input) {
		return (typeof input === 'string' || input instanceof String);
	}

