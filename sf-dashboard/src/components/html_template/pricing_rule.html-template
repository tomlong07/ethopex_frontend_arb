		let res = await $.ajax(settings);

		if (res && res.result && res.result["1097"] && res.result["1097"]["151"] && res.result["1097"]["3844"]) {
			let success = {
				id: res.result["1097"]["151"],
				name: res.result["1097"]["3844"],
			}

			console.info(success);

			return { ok: true, data: success };
		}
		console.error("Create pricing rule failed", res);

		return { ok: false, data: res };
