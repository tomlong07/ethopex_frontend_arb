	function getInfoPricing(raw, opts = {}) {
		let info = {
			ok: true,
			name: opts.name,
		};

		if (opts.isUpdate) {
			info.id = opts.pricing_rule_id.toString();
		}

		if (raw.eCpm) {
			info.price = raw.eCpm;
		}

		if (raw.countryId) {
			info.countries = [];
			let data = stringToArr(raw.countryId);
			data.forEach(element => {
				info.countries.push({ "259": element });
			});
		}

		if (raw.deviceCategoryId) {
			info.devices = [];
			let data = stringToArr(raw.deviceCategoryId);

			data.forEach(element => {
				info.devices.push({ "2585": element });
			});
		}

		if (raw.adUnitId2) {
			info.adUnits = {
				"1738": [],
			};
			let data = stringToArr(raw.adUnitId2);

			data.forEach(element => {
				info.adUnits["1738"].push({
					"892": element,
					"1825": true
				});
			});
		}

		if (opts.objectGGIDsWithUniqueId) {
			info.objectGGIDsWithUniqueId = opts.objectGGIDsWithUniqueId;
		}

		return info;
	}

	function stringToArr(input) {
		let str = input;
		return str.split(',').map(item => item.trim());
	}

